<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <PreferenceCategory app:title="@string/pref_search_title">
        <SeekBarPreference
            android:max="20"
            app:defaultValue="3"
            app:key="radius_km"
            app:min="1"
            app:showSeekBarValue="true"
            app:summary="@string/pref_radius_summary"
            app:title="@string/pref_radius_title"
            app:updatesContinuously="false" />
        <MultiSelectListPreference
            app:defaultValue="@array/category_defaults"
            app:entries="@array/category_labels"
            app:entryValues="@array/category_values"
            app:key="poi_categories"
            app:title="@string/pref_categories_title" />
    </PreferenceCategory>
</PreferenceScreen>
